{
  "$schema": "https://opencode.ai/config.json",
  "project": {
    "name": "FakeData",
    "type": "chrome-extension",
    "language": "javascript",
    "packageManager": "npm"
  },
  "model": {
    "provider": "opencode",
    "id": "nemotron-3-ultra-free",
    "temperature": 0.3,
    "maxTokens": 8192
  },
  "testing": {
    "framework": "vitest",
    "environment": "jsdom",
    "coverage": {
      "provider": "v8",
      "thresholds": {
        "lines": 90,
        "functions": 90,
        "branches": 80,
        "statements": 90
      }
    },
    "commands": {
      "test": "npm test",
      "coverage": "npm run test:coverage"
    }
  },
  "build": {
    "type": "chrome-extension",
    "manifest": "manifest.json",
    "output": "dist/",
    "packageExclude": [
      "node_modules/**",
      "tests/**",
      "coverage/**",
      ".git/**",
      ".opencode/**",
      "*.md",
      "vitest.config.js",
      "package*.json",
      ".github/**"
    ]
  },
  "git": {
    "hooksEnabled": true,
    "conventionalCommits": true,
    "branchPrefixes": [
      "feature/",
      "fix/",
      "refactor/",
      "docs/",
      "chore/"
    ]
  },
  "ide": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": "source.fixAll"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "language": "pt-BR"
}