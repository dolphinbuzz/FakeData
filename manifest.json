{
  "manifest_version": 3,
  "name": "FakeData",
  "version": "1.0.1",
  "description": "Gere dados falsos para testes de QA de forma rápida.",
  "action": {
    "default_title": "FakeData",
    "default_popup": "src/popup.html"
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
