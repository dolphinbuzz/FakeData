{
  "$schema": "https://opencode.ai/config.json",
  "project": {
    "name": "FakeData",
    "type": "chrome-extension",
    "language": "javascript",
    "packageManager": "npm"
  },
  "model": {
    "provider": "opencode",
    "id": "nemotron-3-ultra-free",
    "temperature": 0.3,
    "maxTokens": 8192
  },
  "agents": {},
  "skills": {
    "fakedata-architect": {
      "description": "Architectural decisions and ADR management for FakeData extension",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-architect.md"
    },
    "fakedata-generator": {
      "description": "Data generation logic for FakeData",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-generator.md"
    },
    "fakedata-selector-engine": {
      "description": "Selector engine for field mapping",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-selector-engine.md"
    },
    "fakedata-content-script": {
      "description": "Content script injection and page interaction",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-content-script.md"
    },
    "fakedata-messaging": {
      "description": "Messaging protocol between popup and content script",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-messaging.md"
    },
    "fakedata-storage-profile": {
      "description": "Storage management and profile handling",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-storage-profile.md"
    },
    "fakedata-testing": {
      "description": "Testing strategies and Vitest configuration",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-testing.md"
    },
    "fakedata-devops": {
      "description": "DevOps, CI/CD, and build configuration",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-devops.md"
    },
    "fakedata-documentation": {
      "description": "Documentation generation and maintenance",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-documentation.md"
    },
    "fakedata-ui-ux": {
      "description": "UI/UX design and implementation",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": ["read", "write", "edit", "glob", "grep", "shell", "question"],
      "system_prompt_file": ".opencode/skills/fakedata-ui-ux.md"
    }
  },
  // Gate de push do OpenCode V2 (a chave legada "hooks" não é suportada no V2 e foi removida).
  // Matching (https://opencode.ai/v2/docs/permissions): a regra é comparada com a string crua
  // do comando produzida pelo scanner de shell, usando curingas de valor inteiro ("*" = zero ou
  // mais caracteres, inclusive "/"; "?" = um caractere). A ÚLTIMA regra que casa vence. Um
  // pattern terminado em " *" também casa o comando sem argumentos. Sem regra que case, vale a
  // política base (allow), por isso as variações de push abaixo são declaradas explicitamente.
  "permissions": [
    // Comando isolado: "git push", "git push origin main", "git push --force-with-lease", etc.
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    // Comando prefixado/composto, como no Windows/PowerShell:
    // "$env:CONFIRM_PUSH='true'; git push origin main" (o scanner pode reportar a string inteira,
    // então "*git push*" casa "git push" em qualquer posição do comando).
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    // Variações de invocação que não começam com "git push": git -C <dir>, git -c <chave>=<valor>,
    // o executável com extensão (git.exe/git.cmd) e o caminho absoluto para o binário.
    { "action": "shell", "resource": "*git -C * push*", "effect": "ask" },
    { "action": "shell", "resource": "*git -c * push*", "effect": "ask" },
    { "action": "shell", "resource": "*git.exe*push*", "effect": "ask" },
    { "action": "shell", "resource": "*git.cmd*push*", "effect": "ask" },
    // Limitação residual: aliases do próprio git (ex.: "git p" apontando para push) não são
    // reconhecíveis por pattern de texto. A evolução estrutural recomendada pela doc é inverter a
    // política base: "ask" por padrão + allowlist estreita dos comandos rotineiros (git status etc.).
  ],
  "workflows": [
    "feature-development",
    "bug-fix",
    "refactoring",
    "cross-cutting-change",
    "release-preparation"
  ],
  "context": [
    ".opencode/context/architecture-decisions.md",
    ".opencode/context/api-contracts.md",
    ".opencode/context/coding-standards.md",
    ".opencode/context/testing-strategy.md"
  ],
  "memory": {
    "enabled": true,
    "directory": ".opencode/memory",
    "perAgent": true
  },
  "testing": {
    "framework": "vitest",
    "environment": "jsdom",
    "coverage": {
      "provider": "v8",
      "thresholds": {
        "lines": 90,
        "functions": 90,
        "branches": 80,
        "statements": 90
      }
    },
    "commands": {
      "test": "npm test",
      "coverage": "npm run test:coverage",
      "mutation": "npm run test:mutation"
    }
  },
  "build": {
    "type": "chrome-extension",
    "manifest": "manifest.json",
    "output": "dist/",
    "packageExclude": [
      "node_modules/**",
      "tests/**",
      "coverage/**",
      ".git/**",
      ".opencode/**",
      "*.md",
      "vitest.config.js",
      "stryker.config.json",
      "package*.json",
      ".github/**"
    ]
  },
  // Bloco legado: não é um campo suportado do OpenCode V2; mantido como convenção do time.
  "git": {
    "conventionalCommits": true,
    "branchPrefixes": [
      "feature/",
      "fix/",
      "refactor/",
      "docs/",
      "chore/"
    ]
  },
  "ide": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": "source.fixAll"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "language": "pt-BR"
}